---
const year = new Date().getFullYear();
---

<footer class="site">
  <div class="container">
    <div class="row">
      <div style="max-width: 320px;">
        <a class="brand" href="/" style="font-size: 18px;">
          <span class="gmark">G</span>
          <span>Genable</span>
        </a>
        <p style="margin-top: 12px; color: var(--muted); font-size: 14px; line-height: 1.55;">
          Hand off the design busywork. Free Figma plugin, BYO API key.
        </p>
      </div>

      <div>
        <h4>Product</h4>
        <ul>
          <li><a href="/features/components">Components</a></li>
          <li><a href="/features/pages">Pages</a></li>
          <li><a href="/features/variables">Variables</a></li>
          <li><a href="/features/variants">Variants</a></li>
          <li><a href="/features/system">Design system</a></li>
        </ul>
      </div>

      <div>
        <h4>Resources</h4>
        <ul>
          <li><a href="/quickstart">Quickstart</a></li>
          <li><a href="/docs">Docs</a></li>
          <li><a href="/examples">Examples</a></li>
          <li><a href="/changelog">Changelog</a></li>
        </ul>
      </div>

      <div>
        <h4>Community</h4>
        <ul>
          <li><a href="https://github.com/musepy/genable" target="_blank" rel="noreferrer">GitHub</a></li>
          <li><a href="https://www.npmjs.com/package/genable-mcp" target="_blank" rel="noreferrer">genable-mcp on npm</a></li>
          <li><a href="https://www.figma.com/community/plugin/1583731690321161934" target="_blank" rel="noreferrer">Figma Community</a></li>
        </ul>
      </div>
    </div>

    <div style="margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--hair-soft); display: flex; justify-content: space-between; align-items: center; color: var(--micro); font-size: 13px;">
      <span>© {year} Genable. MIT licensed.</span>
      <span class="eyebrow" style="font-size: 11px;">Made with Genable</span>
    </div>
  </div>
</footer>
