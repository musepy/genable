---
const path = Astro.url.pathname;
const is = (p: string) => path === p || path.startsWith(p + '/');
---

<nav class="topnav" aria-label="Primary navigation">
  <div class="topnav-inner">
    <a class="brand" href="/">
      <span class="gmark">G</span>
      <span>Genable</span>
    </a>

    <div class="links">
      <a href="/features" class:list={[is('/features') && 'is-active']}>Features</a>
      <a href="/quickstart" class:list={[is('/quickstart') && 'is-active']}>Quickstart</a>
      <a href="/docs" class:list={[is('/docs') && 'is-active']}>Docs</a>
      <a href="/examples" class:list={[is('/examples') && 'is-active']}>Examples</a>
      <a href="https://github.com/musepy/genable" target="_blank" rel="noreferrer">GitHub ↗</a>
      <a href="/quickstart" class="nav-cta">
        Get started
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</nav>

<style>
  .links a.is-active { color: var(--ink); }
  .nav-cta {
    display: inline-flex !important;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--ink);
    color: #fff !important;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14.5px;
    letter-spacing: -0.01em;
    box-shadow: 0 8px 16px -10px rgba(0, 0, 0, 0.5);
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }
  .nav-cta .arrow {
    display: inline-block;
    transition: transform 0.18s ease;
    color: #fff;
  }
  .nav-cta:hover {
    color: #fff !important;
    transform: translateY(-1px);
    box-shadow: 0 12px 22px -12px rgba(0, 0, 0, 0.55);
  }
  .nav-cta:hover .arrow { transform: translateX(2px); }
  @media (max-width: 760px) {
    .links { gap: 0 !important; }
    .links > a:not(.nav-cta) { display: none; }
    .nav-cta { padding: 9px 15px; }
  }
</style>
