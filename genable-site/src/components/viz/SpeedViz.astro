---
const heights = [38, 56, 44, 70, 52, 84, 66];
---

<div class="speed">
  <span class="num">8<em>s</em></span>
  <div class="bars">
    {heights.map((h, i) => (
      <i style={`height: ${h}%`} class:list={[i === 5 && 'hot']}></i>
    ))}
  </div>
</div>

<style>
  .speed { display: flex; align-items: flex-end; gap: 14px; }
  .num { font-size: 56px; font-weight: 800; line-height: 0.85; letter-spacing: -0.05em; color: #fff; }
  .num em { color: var(--accent); font-style: normal; }
  .bars { flex: 1; display: flex; align-items: flex-end; gap: 5px; height: 64px; }
  .bars i { flex: 1; border-radius: 4px; background: rgba(255,255,255,0.18); }
  .bars i.hot { background: var(--accent); }
</style>
