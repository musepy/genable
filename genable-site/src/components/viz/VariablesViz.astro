---
const vars = [
  { name: '/color/brand/primary', val: '#3B6FD4', kind: 'color' },
  { name: '/color/text/default',  val: '#0A0A0A', kind: 'color' },
  { name: '/space/lg',            val: '24',      kind: 'num' },
  { name: '/font/display',        val: 'Inter 800', kind: 'text' },
];
---

<div class="vars">
  {vars.map(v => (
    <div class="r">
      {v.kind === 'color'
        ? <span class="sw" style={`background:${v.val}`}></span>
        : <span class="sw outline"></span>
      }
      <span class="n">{v.name}</span>
      <span class="modes">
        <i class="m"></i>
        <i class="m d"></i>
      </span>
    </div>
  ))}
</div>

<style>
  .vars { display: flex; flex-direction: column; gap: 4px; font-family: var(--font-mono); font-size: 11px; }
  .r { display: flex; align-items: center; gap: 8px; padding: 4px 8px; border-radius: 6px;
       background: rgba(10,10,10,0.04); }
  .sw { width: 12px; height: 12px; border-radius: 3px; border: 1px solid rgba(10,10,10,0.10); flex: none; }
  .sw.outline { background: transparent; border: 1.5px solid var(--ink-2); }
  .n { flex: 1; color: var(--ink-2); font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .modes { display: flex; gap: 3px; }
  .m { width: 8px; height: 8px; border-radius: 999px; background: #FAFAFA; border: 1px solid var(--hair); display: inline-block; }
  .m.d { background: var(--ink); border-color: var(--ink); }
</style>
