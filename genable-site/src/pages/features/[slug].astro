---
import Layout from '../../layouts/Layout.astro';

export function getStaticPaths() {
  return [
    {
      params: { slug: 'pages' },
      props: {
        eyebrow: 'VISUAL DIRECTION',
        title: 'Start from the brief, not a preset shell.',
        intro: 'A useful page direction begins with who it is for, what it needs to communicate, and how it should feel. Give Genable that context and the agent can turn it into hierarchy, density, section rhythm, and native Figma structure.',
        promptExample: 'A launch page for a field-operations app. Audience: operations leads comparing tools. Tone: calm, editorial, high information clarity. One clear hero, evidence, workflow, pricing, FAQ. Use a restrained blue accent, strong type contrast, and native Auto Layout sections.',
        what: [
          'Plan a focal point and content sequence from the brief',
          'Create separate, named frames for the requested sections',
          'Use nested Auto Layout instead of a single flat composition',
          'Carry brand, mood, type, and density constraints into the build',
          'Inspect the resulting structure and continue refining it',
        ],
        fit: 'Marketing pages, product flows, dashboards, settings, and other compositions where hierarchy matters as much as the individual nodes.',
        next: { label: 'See native components →', href: '/features/components' },
      },
    },
    {
      params: { slug: 'components' },
      props: {
        eyebrow: 'NATIVE COMPONENTS',
        title: 'Build component sets as editable Figma structure.',
        intro: 'A detailed component brief can describe variants, sizes, states, content, and layout behavior together. Genable works through Figma operations, so the result remains a set of nodes and component properties you can inspect and edit.',
        promptExample: 'A primary button system: solid, outline, and ghost × small, medium, and large × default, hover, and disabled. Use Auto Layout, named Variant / Size / State properties, an optional icon slot, and our existing brand/primary variable.',
        what: [
          'Create component frames with Auto Layout',
          'Combine related components into a named variant set',
          'Add component properties and instance-swap or Boolean slots when requested',
          'Apply text, fills, strokes, spacing, and sizing through typed edits',
          'Read the created structure back before the next refinement',
        ],
        fit: 'Buttons, fields, cards, alerts, navigation, and other patterns whose states and properties need to stay explicit.',
        next: { label: 'See variables →', href: '/features/variables' },
      },
    },
    {
      params: { slug: 'variables' },
      props: {
        eyebrow: 'VARIABLES',
        title: 'Express tokens as variables, not scattered values.',
        intro: 'When the brief calls for a token system, Genable can create collections, add modes, set values, and bind supported Figma properties. The variable model stays visible in the file, where you can review names, scopes, and bindings.',
        promptExample: 'Create a Brand collection with light and dark modes. Add semantic color variables for text, surface, border, and accent plus a 4 / 8 / 12 / 16 / 24 / 32 spacing scale. Bind supported fills, strokes, gaps, and paddings to those variables.',
        what: [
          'Create variable collections and modes',
          'Add color, number, string, or Boolean variables where the system needs them',
          'Bind variables to supported node properties',
          'Use aliases when the requested semantic structure calls for them',
          'Inspect collections and bindings after the write',
        ],
        fit: 'Brand tokens, light and dark modes, spacing scales, semantic color systems, and designs that need inspectable values.',
        next: { label: 'See variants →', href: '/features/variants' },
      },
    },
    {
      params: { slug: 'variants' },
      props: {
        eyebrow: 'VARIANTS',
        title: 'Build related states together.',
        intro: 'States are easier to compare when their differences are explicit. Ask for the matrix up front and Genable can create the related components, combine them, and expose named properties in the same canvas workflow.',
        promptExample: 'Create a notification card set with Tone=Info|Success|Warning and Density=Comfortable|Compact. Keep the content structure consistent, expose a dismiss Boolean, and use the existing semantic color variables.',
        what: [
          'Create related components from one variant brief',
          'Combine components into a variant set',
          'Add named variant and component properties',
          'Keep shared structure visible across states',
          'Inspect the set and revise individual states in context',
        ],
        fit: 'Component states, sizes, densities, tones, and other related forms that benefit from a visible matrix.',
        next: { label: 'See design system →', href: '/features/system' },
      },
    },
    {
      params: { slug: 'system' },
      props: {
        eyebrow: 'DESIGN SYSTEM',
        title: 'Bring reusable design direction into the session.',
        intro: 'Genable can organize Figma pages and sections as it builds. You can also import a design.md into the plugin\'s skill library and attach it to a chat turn, so the same documented tokens and conventions can guide more than one prompt.',
        promptExample: 'Use the attached Product UI design.md. Create pages for Foundations / Components / Patterns. In Foundations, show the documented color, typography, and spacing tokens. Group each component family in a named Section and follow the naming rules from the document.',
        what: [
          'Create and switch between named Figma pages',
          'Group related work in Sections and named frames',
          'Create variables, components, and examples in the same file',
          'Import design.md files as user-managed skills',
          'Attach the relevant design document when a prompt needs that context',
          'Inspect naming and structure before continuing',
        ],
        fit: 'Design-system foundations, component-library starts, client handoffs, and any workflow that benefits from documented constraints.',
        next: { label: 'See checks →', href: '/features/checks' },
        designMd: true,
      },
    },
    {
      params: { slug: 'checks' },
      props: {
        eyebrow: 'CHECK & REFINE',
        title: 'Inspect the structure. See the result. Continue.',
        intro: 'Generation is one part of the loop. Genable can read node properties, search the tree, capture a canvas screenshot, and apply follow-up edits while the current session still has the design context.',
        promptExample: 'Build the settings page, then inspect its frame hierarchy and variable bindings. Capture a screenshot, check the visual emphasis and spacing, and correct the issues you find without replacing unrelated nodes.',
        what: [
          'Search and inspect created nodes',
          'Read selected properties and variable bindings',
          'Capture a screenshot for visual review',
          'Apply focused edits to the existing structure',
          'Continue the conversation from the current session context',
        ],
        fit: 'Any design where editable output, structural checks, and visual iteration matter more than a one-shot image.',
        next: { label: 'Back to features →', href: '/features' },
      },
    },
  ];
}

const { eyebrow, title, intro, promptExample, what, fit, next, designMd } = Astro.props;
---

<Layout title={`${title} — Genable`} description={intro}>
  <section>
    <div class="container" style="max-width: 880px;">
      <a href="/features" style="display: inline-block; margin-bottom: 24px; color: var(--muted); font-size: 14px;">← All features</a>
      <span class="eyebrow">{eyebrow}</span>
      <h1 style="margin-top: 16px;">{title}</h1>
      <p class="lead muted" style="margin-top: 28px;">{intro}</p>
    </div>
  </section>

  <section style="background: var(--bg-deep); border-top: 1px solid var(--hair-soft);">
    <div class="container row-2">
      <div>
        <span class="eyebrow">AN EXAMPLE BRIEF</span>
        <h2 style="margin-top: 16px; font-size: clamp(28px, 3.5vw, 40px);">{promptExample}</h2>
      </div>
      <div>
        <span class="eyebrow">WHAT THE AGENT CAN DO</span>
        <ul class="what">
          {what.map((item: string) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section style="border-top: 1px solid var(--hair-soft);">
    <div class="container">
      <span class="eyebrow">GOOD FIT</span>
      <p class="lead" style="margin-top: 16px; max-width: 720px;">{fit}</p>

      {designMd && (
        <div class="design-md-box">
          <span class="eyebrow" style="color: var(--accent);">USER-IMPORTED DESIGN CONTEXT</span>
          <h3 style="margin-top: 12px;">Import a design.md into the skill library.</h3>
          <p class="muted" style="margin-top: 8px; max-width: 720px;">
            Add the document in Genable, then attach it to the chat turn that should use it. This keeps the design direction explicit and user-managed; importing a file does not silently apply it to every generation.
          </p>
          <div style="margin-top: 20px; display: flex; gap: 10px; flex-wrap: wrap;">
            <a class="btn btn-ghost" href="/docs">Read the Genable docs →</a>
            <a class="btn btn-ghost" href="/examples">Adapt an example brief →</a>
          </div>
        </div>
      )}

      <div style="margin-top: 56px; display: flex; gap: 14px; flex-wrap: wrap;">
        <a class="btn btn-primary" href="/quickstart">Try it →</a>
        <a class="btn btn-ghost" href={next.href}>{next.label}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .what { list-style: none; padding: 0; margin: 16px 0 0; display: flex; flex-direction: column; gap: 14px; }
  .what li {
    padding-left: 24px; position: relative; font-size: 17px; line-height: 1.55; color: var(--ink-2);
  }
  .what li::before {
    content: '✓'; color: var(--accent); font-weight: 800; position: absolute; left: 0; top: 0;
  }
  .design-md-box {
    margin-top: 56px; padding: 32px;
    border-radius: var(--r-lg);
    background: color-mix(in srgb, var(--accent) 5%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--accent) 18%, transparent);
  }
  .design-md-box h3 { font-size: 24px; }
</style>
