---
import Layout from '../layouts/Layout.astro';

const figmaCommunity = 'https://www.figma.com/community/plugin/1583731690321161934';
---

<Layout>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">FIGMA · AI DESIGN AGENT</span>
        <h1>
          Use your model.
          <br />
          <span class="stanza-accent">Keep the design.</span>
        </h1>
        <p class="lead">
          Bring the model you trust into Figma. Genable turns a detailed brief
          into <strong>native, editable structure</strong> you can inspect and refine.
        </p>

        <div class="entries" aria-label="Get started with Genable">
          <a class="entry" href={figmaCommunity} target="_blank" rel="noreferrer">
            <span class="entry-index">01</span>
            <span class="entry-body">
              <span class="entry-eyebrow">INSIDE FIGMA</span>
              <strong>Install the plugin</strong>
              <span>Connect a supported provider and refine in conversation.</span>
            </span>
            <span class="entry-arrow" aria-hidden="true">↗</span>
          </a>

          <a class="entry entry-dark" href="/quickstart#mcp">
            <span class="entry-index">02</span>
            <span class="entry-body">
              <span class="entry-eyebrow">FROM AN MCP CLIENT</span>
              <strong>Connect genable-mcp</strong>
              <span>Your client supplies the model; Genable supplies the path into Figma.</span>
            </span>
            <span class="entry-arrow" aria-hidden="true">→</span>
          </a>
        </div>

        <div class="proof">
          <span class="chip">Genable is free · Provider usage applies</span>
          <span class="chip dark">Plugin · Local MCP bridge</span>
        </div>
      </div>

      <aside class="brief-sheet" aria-label="Example design brief">
        <div class="sheet-head">
          <span class="eyebrow">BRIEF / 01</span>
          <span class="sheet-status"><i></i> READY</span>
        </div>
        <p class="sheet-prompt">
          A calm analytics dashboard for finance teams. Lead with portfolio
          health, keep tables compact, and bind the color system to variables.
        </p>
        <dl>
          <div><dt>Audience</dt><dd>Finance teams</dd></div>
          <div><dt>Direction</dt><dd>Calm · exact · editorial</dd></div>
          <div><dt>Density</dt><dd>Compact data · generous margins</dd></div>
          <div><dt>Output</dt><dd>Native Figma structure</dd></div>
        </dl>
        <div class="sheet-foot">
          <span>BRIEF</span><i></i><span>PLAN</span><i></i><span>CANVAS</span>
        </div>
      </aside>
    </div>
  </section>

  <section class="loop-section">
    <div class="container">
      <div class="section-head section-head-light">
        <span class="eyebrow">THE AGENT LOOP</span>
        <h2>Plans. Builds. Checks.</h2>
        <p class="lead">
          A brief becomes a visual direction, then native structure, then a result
          Genable can inspect before the next move.
        </p>
      </div>

      <ol class="loop-list">
        <li>
          <span class="loop-num">01</span>
          <div>
            <span class="eyebrow">PLAN · COMPOSITION</span>
            <h3>Make the direction explicit.</h3>
          </div>
          <p>Audience and content shape hierarchy. Brand and mood guide type, rhythm, surfaces, and data presentation.</p>
          <div class="loop-tags"><span>Hierarchy</span><span>Visual system</span></div>
        </li>
        <li>
          <span class="loop-num">02</span>
          <div>
            <span class="eyebrow">BUILD · STRUCTURE</span>
            <h3>Act on the Figma canvas.</h3>
          </div>
          <p>Typed design operations create and edit frames, Auto Layout, vectors, components, variables, and pages.</p>
          <div class="loop-tags"><span>Native layers</span><span>Reusable parts</span></div>
        </li>
        <li>
          <span class="loop-num">03</span>
          <div>
            <span class="eyebrow">CHECK · REFINE</span>
            <h3>Look again, then continue.</h3>
          </div>
          <p>Inspect structure, read back writes, review screenshots when useful, and make the next change with the current design in context.</p>
          <div class="loop-tags"><span>Inspect</span><span>Screenshot</span></div>
        </li>
      </ol>
    </div>
  </section>

  <section class="direction-section">
    <div class="container direction-grid">
      <div class="direction-copy">
        <span class="eyebrow">VISUAL DIRECTION</span>
        <h2>
          A visual direction.
          <span>Not a preset shell.</span>
        </h2>
        <p class="lead muted">
          Generic outputs often begin with generic briefs. Genable makes
          audience, hierarchy, typography, density, rhythm, and brand mood part
          of the task—not just the accent color.
        </p>
        <p class="direction-note">
          The model and brief still matter. Genable keeps intent visible and the
          result editable so refinement stays part of the loop.
        </p>
      </div>

      <div class="direction-ledger" aria-label="Design direction dimensions">
        <div><span class="eyebrow">BRIEF</span><strong>Audience · Content</strong><i>01</i></div>
        <div><span class="eyebrow">DIRECTION</span><strong>Brand · Mood</strong><i>02</i></div>
        <div><span class="eyebrow">HIERARCHY</span><strong>Type · Density · Rhythm</strong><i>03</i></div>
        <div class="ledger-output"><span class="eyebrow">OUTPUT</span><strong>Native Figma structure</strong><i>04</i></div>
      </div>
    </div>
  </section>

  <section class="models-section">
    <div class="container">
      <div class="models-intro">
        <span class="eyebrow">MODELS · SUPPORTED PROTOCOLS</span>
        <h2>Choose the model that fits the brief.</h2>
        <p class="lead muted">
          The plugin can connect to supported presets or a compatible endpoint.
          Genable validates the provider before the first run and keeps model
          choice in your hands.
        </p>
      </div>
      <div class="protocols">
        <article>
          <span class="protocol-mark">O</span>
          <div><span class="eyebrow">OPENAI PROTOCOL</span><h3>OpenAI-compatible</h3><p>Use a supported preset or configure a compatible endpoint and model.</p></div>
        </article>
        <article>
          <span class="protocol-mark">A</span>
          <div><span class="eyebrow">ANTHROPIC PROTOCOL</span><h3>Anthropic-compatible</h3><p>Connect a native or compatible endpoint and choose a model available to your account.</p></div>
        </article>
        <article>
          <span class="protocol-mark">G</span>
          <div><span class="eyebrow">GEMINI PROTOCOL</span><h3>Google AI Studio</h3><p>Use Genable's Gemini adapter and select from the models available to your provider.</p></div>
        </article>
      </div>
    </div>
  </section>

  <section class="surfaces-section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">TWO SURFACES · ONE ENGINE</span>
        <h2>Meet Genable where you work.</h2>
      </div>

      <div class="surfaces">
        <article class="surface surface-plugin">
          <div class="surface-top"><span class="eyebrow">INSIDE FIGMA</span><span class="surface-no">01</span></div>
          <h3>Plugin</h3>
          <p>Add a provider and API key, describe the brief, then continue refining native layers in conversation.</p>
          <div class="surface-flow"><span>BRIEF</span><i>→</i><span>PLAN</span><i>→</i><span>FIGMA</span></div>
          <div class="surface-links">
            <a href={figmaCommunity} target="_blank" rel="noreferrer">Install from Figma Community ↗</a>
            <a href="/quickstart#plugin">Plugin setup →</a>
          </div>
        </article>

        <article class="surface surface-mcp">
          <div class="surface-top"><span class="eyebrow">FROM YOUR MCP CLIENT</span><span class="surface-no">02</span></div>
          <h3>genable-mcp</h3>
          <p>Use the model already configured in a STDIO MCP client. A local bridge relays typed design operations to the Genable plugin.</p>
          <div class="surface-flow"><span>MCP CLIENT</span><i>→</i><span>LOCAL BRIDGE</span><i>→</i><span>FIGMA</span></div>
          <div class="surface-links">
            <a href="/quickstart#mcp">Set up genable-mcp →</a>
            <a href="https://www.npmjs.com/package/genable-mcp" target="_blank" rel="noreferrer">View npm package ↗</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="faq">
    <div class="container faq-grid">
      <div class="section-head">
        <span class="eyebrow">CLEAR CLAIMS</span>
        <h2>What Genable is—and is not.</h2>
      </div>
      <div class="qs">
        <details open>
          <summary>Does Genable guarantee “AI-slop-free” design?</summary>
          <p>No tool can guarantee taste. Genable addresses generic output by making the brief and visual direction explicit, keeping output native and inspectable, and supporting continued refinement. The model, source material, and judgment still matter.</p>
        </details>
        <details>
          <summary>Is Genable free?</summary>
          <p>The Figma plugin is free, and the <a href="https://www.npmjs.com/package/genable-mcp" target="_blank" rel="noreferrer">MCP package</a> is MIT-licensed. Your model provider or MCP client may apply its own billing and limits.</p>
        </details>
        <details>
          <summary>Where do provider credentials and requests go?</summary>
          <p>The plugin stores provider credentials in Figma client storage. Requests go to the endpoint you configure; some presets can use a relay when browser-network constraints require it. The MCP path receives model access from your client and connects to Figma through a local bridge.</p>
        </details>
        <details>
          <summary>What makes the output editable?</summary>
          <p>Genable operates on Figma's scene graph through typed tools. It can create and modify native frames, Auto Layout, vectors, text, components, variables, and pages instead of returning a single flattened image.</p>
        </details>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container cta-inner">
      <span class="eyebrow">START WITH A REAL BRIEF</span>
      <h2>Bring your model into Figma.</h2>
      <p class="lead">Use the plugin in Figma, or connect the same canvas to your MCP workflow.</p>
      <div class="cta">
        <a class="btn btn-primary" href={figmaCommunity} target="_blank" rel="noreferrer">Install the plugin ↗</a>
        <a class="btn btn-ghost" href="/quickstart#mcp">Set up genable-mcp →</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero { padding-top: clamp(72px, 8vw, 120px); padding-bottom: clamp(80px, 10vw, 148px); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.28fr) minmax(320px, 0.72fr); gap: clamp(48px, 7vw, 100px); align-items: end; }
  .hero-copy > .eyebrow { display: inline-block; margin-bottom: 26px; }
  .hero h1 { font-size: clamp(58px, 7.3vw, 112px); }
  .hero .lead { margin-top: 30px; }
  .hero .lead strong { color: var(--ink); }

  .entries { display: grid; gap: 10px; max-width: 760px; margin-top: 40px; }
  .entry { display: grid; grid-template-columns: 42px 1fr auto; gap: 18px; align-items: center; padding: 17px 20px; border-top: 1px solid var(--hair); background: var(--surface); color: var(--ink); transition: transform 0.16s ease, border-color 0.16s ease; }
  .entry:last-child { border-bottom: 1px solid var(--hair); }
  .entry:hover { transform: translateX(4px); color: inherit; border-color: var(--ink); }
  .entry-dark { background: var(--ink); color: #fff; border-color: var(--ink); }
  .entry-dark:hover { color: #fff; }
  .entry-index { font-family: var(--font-mono); font-size: 11px; color: var(--micro); }
  .entry-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .entry-eyebrow { font: 600 10px/1.4 var(--font-mono); letter-spacing: 0.18em; color: var(--micro); }
  .entry-body strong { font-size: 18px; letter-spacing: -0.015em; }
  .entry-body > span:last-child { color: var(--muted); font-size: 14px; line-height: 1.45; }
  .entry-dark .entry-body > span:last-child { color: rgba(255,255,255,0.64); }
  .entry-arrow { font-size: 18px; color: var(--accent); }
  .proof { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }

  .brief-sheet { align-self: end; padding: 28px; background: var(--accent-soft); border-top: 3px solid var(--accent); border-bottom: 1px solid rgba(59,111,212,0.28); transform: rotate(1.25deg); box-shadow: 18px 24px 44px -36px rgba(10,10,10,0.42); }
  .sheet-head { display: flex; align-items: center; justify-content: space-between; padding-bottom: 18px; border-bottom: 1px solid rgba(59,111,212,0.22); }
  .sheet-status { font: 700 10px/1 var(--font-mono); letter-spacing: 0.14em; color: var(--accent-ink); display: inline-flex; align-items: center; gap: 7px; }
  .sheet-status i { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  .sheet-prompt { margin: 28px 0; font-size: clamp(20px, 2vw, 26px); line-height: 1.38; font-weight: 700; letter-spacing: -0.025em; }
  .brief-sheet dl { margin: 0; }
  .brief-sheet dl div { display: grid; grid-template-columns: 100px 1fr; gap: 14px; padding: 10px 0; border-top: 1px solid rgba(59,111,212,0.16); }
  .brief-sheet dt { font: 600 10px/1.5 var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent-ink); }
  .brief-sheet dd { margin: 0; font-size: 14px; font-weight: 600; }
  .sheet-foot { display: flex; align-items: center; gap: 8px; margin-top: 24px; font: 700 10px/1 var(--font-mono); letter-spacing: 0.12em; color: var(--accent-ink); }
  .sheet-foot i { height: 1px; flex: 1; background: var(--accent); opacity: 0.45; }

  .section-head { max-width: 820px; margin-bottom: 56px; }
  .section-head > .eyebrow, .models-intro > .eyebrow { display: inline-block; margin-bottom: 18px; }
  .section-head h2, .models-intro h2 { margin-bottom: 22px; }

  .loop-section { background: var(--ink); color: #fff; }
  .section-head-light .eyebrow, .loop-list .eyebrow { color: #8fb1ef; }
  .section-head-light .lead { color: rgba(255,255,255,0.68); }
  .loop-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(255,255,255,0.18); }
  .loop-list li { display: grid; grid-template-columns: 64px minmax(220px, 0.8fr) minmax(300px, 1fr) auto; gap: 28px; align-items: center; padding: 32px 0; border-bottom: 1px solid rgba(255,255,255,0.18); }
  .loop-num { font: 500 13px/1 var(--font-mono); color: rgba(255,255,255,0.36); }
  .loop-list h3 { margin-top: 7px; font-size: clamp(25px, 3vw, 38px); }
  .loop-list p { color: rgba(255,255,255,0.65); font-size: 16px; line-height: 1.55; max-width: 560px; }
  .loop-tags { display: flex; gap: 6px; justify-content: flex-end; flex-wrap: wrap; }
  .loop-tags span { padding: 6px 9px; border: 1px solid rgba(255,255,255,0.18); font: 600 10px/1 var(--font-mono); color: rgba(255,255,255,0.74); }

  .direction-section { overflow: hidden; }
  .direction-grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(440px, 1.1fr); gap: clamp(52px, 8vw, 116px); align-items: center; }
  .direction-copy > .eyebrow { display: inline-block; margin-bottom: 18px; }
  .direction-copy h2 span { display: block; margin-top: 6px; color: var(--accent); font-family: var(--font-serif); font-style: italic; font-weight: 600; letter-spacing: -0.045em; }
  .direction-copy .lead { margin-top: 28px; }
  .direction-note { max-width: 620px; margin-top: 22px; padding-left: 16px; border-left: 2px solid var(--accent); color: var(--ink-2); font-size: 15px; }
  .direction-ledger { border-top: 2px solid var(--ink); transform: rotate(-1deg); }
  .direction-ledger > div { position: relative; display: grid; grid-template-columns: 130px 1fr 32px; align-items: center; gap: 20px; padding: 25px 20px; border-bottom: 1px solid var(--hair); }
  .direction-ledger strong { font-size: clamp(19px, 2vw, 28px); letter-spacing: -0.025em; }
  .direction-ledger i { font: normal 500 11px/1 var(--font-mono); color: var(--micro); text-align: right; }
  .direction-ledger .ledger-output { background: var(--accent); color: #fff; border-color: var(--accent); }
  .direction-ledger .ledger-output .eyebrow, .direction-ledger .ledger-output i { color: rgba(255,255,255,0.72); }

  .models-section { background: var(--bg-deep); }
  .models-intro { max-width: 820px; margin-bottom: 54px; }
  .protocols { border-top: 1px solid var(--hair); }
  .protocols article { display: grid; grid-template-columns: 76px 1fr; gap: 24px; padding: 28px 0; border-bottom: 1px solid var(--hair); align-items: start; }
  .protocol-mark { width: 48px; height: 48px; display: grid; place-items: center; background: var(--ink); color: #fff; font: 800 18px/1 var(--font-mono); }
  .protocols .eyebrow { font-size: 10px; }
  .protocols h3 { margin: 5px 0 7px; }
  .protocols p { color: var(--muted); max-width: 680px; }

  .surfaces { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .surface { min-height: 470px; padding: clamp(28px, 4vw, 48px); display: flex; flex-direction: column; border: 1px solid var(--hair); }
  .surface-mcp { background: var(--ink); color: #fff; border-color: var(--ink); }
  .surface-top { display: flex; align-items: center; justify-content: space-between; }
  .surface-no { font: 500 12px/1 var(--font-mono); color: var(--micro); }
  .surface h3 { margin-top: 36px; font-size: clamp(42px, 5vw, 72px); }
  .surface > p { max-width: 540px; margin-top: 18px; color: var(--muted); font-size: 18px; line-height: 1.55; }
  .surface-mcp .eyebrow, .surface-mcp .surface-no { color: rgba(255,255,255,0.46); }
  .surface-mcp > p { color: rgba(255,255,255,0.68); }
  .surface-flow { display: flex; align-items: center; gap: 8px; margin-top: auto; padding: 18px 0; font: 700 10px/1 var(--font-mono); letter-spacing: 0.08em; }
  .surface-flow span { flex: 1; padding: 12px 8px; border: 1px solid var(--hair); text-align: center; }
  .surface-flow i { font-style: normal; color: var(--accent); }
  .surface-mcp .surface-flow span { border-color: rgba(255,255,255,0.18); }
  .surface-links { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 10px; font-size: 14px; font-weight: 700; }
  .surface-mcp .surface-links a { color: #fff; }
  .surface-mcp .surface-links a:hover { color: #8fb1ef; }

  .faq-grid { display: grid; grid-template-columns: minmax(280px, 0.72fr) minmax(0, 1.28fr); gap: clamp(48px, 8vw, 112px); align-items: start; }
  .qs { border-top: 1px solid var(--hair); }
  details { padding: 22px 0; border-bottom: 1px solid var(--hair); }
  details summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; gap: 18px; font-size: 19px; font-weight: 700; }
  details summary::-webkit-details-marker { display: none; }
  details summary::after { content: '+'; color: var(--accent); font-size: 22px; font-weight: 500; }
  details[open] summary::after { content: '−'; }
  details p { margin-top: 15px; color: var(--muted); line-height: 1.65; max-width: 760px; }
  details a { text-decoration: underline; text-underline-offset: 3px; }

  .cta-section { background: var(--accent); color: #fff; }
  .cta-inner { text-align: center; }
  .cta-inner .eyebrow { color: rgba(255,255,255,0.72); }
  .cta-inner h2 { margin-top: 18px; }
  .cta-inner .lead { margin: 18px auto 32px; color: rgba(255,255,255,0.82); }
  .cta { display: flex; justify-content: center; flex-wrap: wrap; gap: 12px; }
  .cta .btn-ghost { color: #fff; border-color: rgba(255,255,255,0.52); }
  .cta .btn-ghost:hover { background: rgba(255,255,255,0.12); color: #fff; }

  @media (max-width: 960px) {
    .hero-grid, .direction-grid, .faq-grid { grid-template-columns: 1fr; }
    .brief-sheet { max-width: 620px; transform: none; }
    .loop-list li { grid-template-columns: 46px 1fr; }
    .loop-list li > p, .loop-tags { grid-column: 2; }
    .loop-tags { justify-content: flex-start; }
    .surfaces { grid-template-columns: 1fr; }
    .surface { min-height: 420px; }
  }

  @media (max-width: 620px) {
    .hero h1 { font-size: clamp(50px, 15vw, 72px); }
    .entry { grid-template-columns: 28px 1fr auto; gap: 12px; padding: 16px 14px; }
    .entry-body > span:last-child { font-size: 13px; }
    .brief-sheet { padding: 22px; }
    .brief-sheet dl div { grid-template-columns: 86px 1fr; }
    .loop-list li { grid-template-columns: 1fr; gap: 14px; }
    .loop-list li > p, .loop-tags { grid-column: 1; }
    .loop-num { padding-top: 4px; }
    .direction-grid { gap: 44px; }
    .direction-ledger > div { grid-template-columns: 1fr 24px; gap: 8px; padding: 20px 14px; }
    .direction-ledger .eyebrow { grid-column: 1 / -1; }
    .protocols article { grid-template-columns: 54px 1fr; gap: 14px; }
    .protocol-mark { width: 42px; height: 42px; }
    .surface { min-height: auto; padding: 26px 20px; }
    .surface-flow { margin-top: 48px; gap: 4px; font-size: 8px; letter-spacing: 0.03em; }
    .surface-flow span { padding: 10px 4px; }
  }
</style>
